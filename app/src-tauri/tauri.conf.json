{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gesture Control",
  "version": "0.1.0",
  "identifier": "com.gesturecontrol.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gesture Control",
        "width": 1000,
        "height": 620,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
